profiles {
  myawsbatch {
    // Keep the official nf-core awsbatch profile in your -profile list
    // but DO NOT set params.awsqueue/awsregion/awscli anywhere.

    process {
      executor = 'awsbatch'               // belt-and-suspenders
      queue    = 'nfcore-scrna-queue-od'  // set the JobQueue directly (no params!)
    }
  }
}

aws {
  region = 'us-east-1'
  batch {
    // Path to aws CLI on Batch instances/AMI (only needed if non-default)
    cliPath = '/usr/bin/aws'
  }
}

// Ensure Nextflow stages and works from S3 (prevents local paths sneaking in)
bucketDir = "s3://my-nfcore-scrna-1/work"
workDir   = "s3://my-nfcore-scrna-1/work"

// Optional: keep it cheap for the test dataset
maxForks = 2
process {
  withLabel:process_low    { cpus = 1; memory = '2 GB'; time = '1h' }
  withLabel:process_medium { cpus = 1; memory = '4 GB'; time = '2h' }
  withLabel:process_high   { cpus = 2; memory = '8 GB'; time = '4h' }
}
