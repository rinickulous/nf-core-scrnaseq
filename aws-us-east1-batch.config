/*
  Local override for AWS Batch in us-east-1
  - points to your queue: nfcore-scrna-queue3
  - uses your S3 work/results buckets
  - avoids the pipeline's built-in eu-west-1 defaults
*/
profiles {
  awsbatch_us {
    process {
      executor = 'awsbatch'
      queue    = 'nfcore-scrna-queue-freetier'   // <-- FREE TIER ONLY (m7i-flex.large: 2 vCPUs, 8 GB)

      // Override default resources to fit Free Tier instances (max 2 vCPUs, 7 GB)
      memory = { 3.GB * task.attempt }
      cpus   = 1

      // Override ALL process labels to fit Free Tier limits
      withLabel:process_single {
        cpus   = 1
        memory = { 3.GB * task.attempt }
      }
      withLabel:process_low {
        cpus   = 1
        memory = { 4.GB * task.attempt }
      }
      withLabel:process_medium {
        cpus   = 2
        memory = { 7.GB * task.attempt }
      }
      withLabel:process_high {
        cpus   = 2
        memory = { 7.GB * task.attempt }
      }
      withLabel:process_high_memory {
        memory = { 7.GB * task.attempt }
      }
    }
    aws {
      region = 'us-east-1'
      batch {
        maxTransferAttempts = 3
        maxSpotAttempts = 3
        volumes = []
      }
      client {
        uploadStorageClass = 'STANDARD'
      }
    }

    fusion {
      enabled = true
      exportStorageCredentials = true
    }

    wave {
      enabled = true
    }

    workDir = 's3://my-nfcore-scrna-1/work'

    docker {
      enabled = true
      runOptions = '--platform linux/amd64'
    }
  }
}
