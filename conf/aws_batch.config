profiles {
  awsbatch_local {
    // Infrastructure only; OK to use with -c (params belong in -params-file)
    process.executor = 'awsbatch'
    // S3 working directory for intermediates:
    workDir = "s3://${params.s3_bucket}/work"

    // Use AWS Batch profile from nf-core/configs; pass these as params
    aws.region = params.awsregion
    aws.batch.cliPath = params.awscli ?: '/usr/bin/aws'

    // Strongly recommended for cloud: Fusion + containers
    fusion {
      enabled = true
      // Export storage creds into tasks if needed (see note):
      // exportStorageCredentials = true
    }

    docker.enabled = true     // use Docker images
    singularity.enabled = false

    // Send task logs and Nextflow reports to your S3 outdir too
    timeline { overwrite = true }
    report   { overwrite = true }
    trace    { overwrite = true }
    dag      { overwrite = true }
  }
}
